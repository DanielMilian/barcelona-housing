# Copy to .env and fill in. Never commit .env.
# Generate each secret with: openssl rand -hex 16

# --- Warehouse (Postgres 16) ---
WAREHOUSE_USER=housing
WAREHOUSE_PASSWORD=change-me
WAREHOUSE_DB=housing
# Host port only; containers always talk to the warehouse on 5432
WAREHOUSE_PORT=5434

# --- Airflow ---
# Your own user id (run: id -u) so bind-mounted files stay writable
AIRFLOW_UID=1000
AIRFLOW_ADMIN_PASSWORD=change-me
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change-me
AIRFLOW_DB_NAME=airflow
# Optional host port for the Airflow UI (default 8080)
# AIRFLOW_PORT=8080

# --- Read-only Viewer user the API uses to call Airflow (created by airflow-init) ---
AIRFLOW_API_USER=api_readonly
AIRFLOW_API_PASSWORD=change-me

# --- API ---
# Sent by clients in the X-API-Key header; the API returns 503 if unset
API_KEY=change-me
